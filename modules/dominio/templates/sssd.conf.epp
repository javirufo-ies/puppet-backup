[sssd]
services = nss, pam
config_file_version = 2
domains = <%= $dominio %>

[domain/ciclos.valledeljerte3]
id_provider = ad
access_provider = ad
override_homedir = /home/%u
default_shell = /bin/bash
use_fully_qualified_names = False
ad_gpo_access_control = permissive
ad_gpo_ignore_unreadable = True
